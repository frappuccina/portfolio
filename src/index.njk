<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ site.title }}</title>
<meta name="description" content="{{ site.description }}">
<link rel="canonical" href="{{ site.url }}">

<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.title }}">
<meta property="og:title" content="{{ site.title }}">
<meta property="og:description" content="{{ site.description }}">
<meta property="og:url" content="{{ site.url }}">
<meta property="og:locale" content="it_IT">
{% if site.share_image %}<meta property="og:image" content="{{ site.url }}{{ site.share_image }}">
<meta property="og:image:alt" content="{{ site.title }}">{% endif %}

<meta name="twitter:card" content="{% if site.share_image %}summary_large_image{% else %}summary{% endif %}">
<meta name="twitter:title" content="{{ site.title }}">
<meta name="twitter:description" content="{{ site.description }}">
{% if site.share_image %}<meta name="twitter:image" content="{{ site.url }}{{ site.share_image }}">{% endif %}

<meta name="theme-color" content="#2A6E3F">
{% if site.favicon %}<link rel="icon" href="{{ site.favicon }}">
<link rel="apple-touch-icon" href="{{ site.favicon }}">
{% else %}<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='22' fill='%232A6E3F'/><text x='50' y='50' dy='.36em' text-anchor='middle' font-size='62' fill='%23E87DB0' font-family='sans-serif'>&#10022;</text></svg>">
{% endif %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,300;12..96,400;12..96,700;12..96,800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --green:  #2A6E3F;
    --cream:  #F0ECD9;
    --pink:   #E87DB0;
    --ink:    #1A1A1A;
    --display: 'Bricolage Grotesque', sans-serif;
    --body:    'DM Sans', sans-serif;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body {
    background: var(--green);
    color: var(--cream);
    font-family: var(--body);
    overflow-x: hidden;
    cursor: none;
  }

  /* ── CURSOR ── */
  #cur { width:14px; height:14px; background:var(--pink); border-radius:50%;
    position:fixed; top:0; left:0; pointer-events:none; z-index:9999;
    transform:translate(-50%,-50%); transition:width .25s,height .25s; }
  #cur.big { width:56px; height:56px; opacity:.35; }
  #ring { width:40px; height:40px; border:1.5px solid var(--cream); border-radius:50%;
    position:fixed; top:0; left:0; pointer-events:none; z-index:9998;
    transform:translate(-50%,-50%); opacity:.4; }

  /* ── NAV ── */
  nav {
    position:fixed; top:0; left:0; right:0; z-index:100;
    display:flex; justify-content:space-between; align-items:center;
    padding:24px 48px;
    transition: background .4s, padding .4s;
  }
  nav.stuck { background: rgba(42,110,63,.96); backdrop-filter:blur(16px); padding:16px 48px; }
  .nav-logo { font-family:var(--display); font-weight:800; font-size:1rem;
    letter-spacing:-.01em; color:var(--cream); text-decoration:none;
    white-space:nowrap; overflow:hidden; text-overflow:ellipsis; min-width:0; }
  .nav-links { display:flex; gap:36px; list-style:none; flex-shrink:0; }
  .nav-links a { font-size:.75rem; letter-spacing:.14em; text-transform:uppercase;
    color:var(--cream); text-decoration:none; opacity:.55; transition:opacity .2s; }
  .nav-links a:hover { opacity:1; }

  /* ── HERO ── */
  #hero {
    min-height:100vh; position:relative; overflow:hidden;
    display:flex; flex-direction:column; justify-content:flex-end;
    padding: 0 0 60px;
  }
  .hero-name-wrap {
    padding: 80px 40px 0;
    position:relative; z-index:2;
  }
  .hero-name {
    font-family:var(--display); font-weight:800;
    font-size: clamp(6rem, 17vw, 18rem);
    line-height:.88; letter-spacing:-.04em;
    color:var(--cream);
    overflow-wrap:break-word;
    opacity:0; animation: nameIn .9s cubic-bezier(.16,1,.3,1) .1s forwards;
  }
  .hero-name .line2 { display:block; padding-left: clamp(2rem,8vw,10rem); }
  .hero-blob {
    position:absolute;
    width: clamp(220px, 32vw, 420px);
    aspect-ratio:1;
    background:var(--pink);
    border-radius:60% 40% 55% 45% / 50% 60% 40% 55%;
    bottom: clamp(80px, 14vw, 180px);
    left: clamp(20px, 5vw, 80px);
    z-index:1;
    animation: blobFloat 7s ease-in-out infinite, blobIn .8s ease .3s both;
  }
  .hero-bottom {
    position:relative; z-index:3;
    display:flex; justify-content:space-between; align-items:flex-end;
    padding: 0 40px;
    margin-top: clamp(20px,4vw,40px);
  }
  .hero-left-info { }
  .hero-year {
    font-family:var(--display); font-weight:700;
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    color:var(--cream); line-height:1; margin-bottom:6px;
    opacity:0; animation:fadeUp .7s ease .55s forwards;
  }
  .hero-role {
    font-size:clamp(.85rem, 1.5vw, 1.05rem);
    font-weight:400; color:rgba(240,236,217,.75);
    opacity:0; animation:fadeUp .7s ease .7s forwards;
  }
  .hero-right-info { text-align:right; max-width:420px; }
  .hero-tagline-bold {
    font-family:var(--display); font-weight:700;
    font-size:clamp(.95rem,1.8vw,1.25rem);
    color:var(--pink); margin-bottom:6px;
    opacity:0; animation:fadeUp .7s ease .65s forwards;
  }
  .hero-tagline {
    font-size:clamp(.85rem,1.4vw,1rem);
    line-height:1.65; color:rgba(240,236,217,.7);
    opacity:0; animation:fadeUp .7s ease .8s forwards;
  }
  .hero-cta {
    display:inline-flex; align-items:center; gap:12px;
    margin-top:20px; font-size:.75rem; letter-spacing:.12em; text-transform:uppercase;
    color:var(--green); background:var(--cream); padding:14px 28px;
    border-radius:100px; text-decoration:none; font-weight:500;
    transition:background .3s, color .3s, transform .3s;
    opacity:0; animation:fadeUp .7s ease .95s forwards;
  }
  .hero-cta:hover { background:var(--pink); color:#fff; transform:translateY(-2px); }

  /* ── MARQUEE ── */
  .marquee-strip {
    background:var(--cream); color:var(--green);
    padding:12px 0; overflow:hidden; white-space:nowrap;
  }
  .marquee-inner { display:inline-flex; animation:marquee 22s linear infinite; }
  .m-item { font-family:var(--display); font-weight:700;
    font-size:clamp(.9rem,1.6vw,1.1rem); letter-spacing:-.01em; padding:0 32px; }
  .m-dot { color:var(--pink); }

  /* ── SECTIONS SHARED ── */
  .sec-label {
    font-size:.68rem; letter-spacing:.18em; text-transform:uppercase;
    color:rgba(240,236,217,.45); margin-bottom:20px;
    display:flex; align-items:center; gap:12px;
  }
  .sec-label::before { content:attr(data-n); color:var(--pink); }

  /* ── ABOUT ── */
  #about { background:var(--cream); color:var(--ink); padding:100px 48px; }
  .about-grid { display:grid; grid-template-columns:1fr 1.2fr; gap:80px; align-items:start; }
  .about-left {}
  .about-heading {
    font-family:var(--display); font-weight:800;
    font-size:clamp(2.4rem, 5vw, 4.8rem);
    line-height:.95; letter-spacing:-.03em; margin-bottom:40px;
    color:var(--ink);
  }
  .about-heading .pink { color:var(--green); }
  .about-text { font-size:.97rem; line-height:1.82; color:#555; margin-bottom:24px; }
  .about-cta-row { display:flex; gap:16px; margin-top:36px; flex-wrap:wrap; }
  .pill {
    display:inline-flex; align-items:center; gap:8px;
    padding:12px 24px; border-radius:100px;
    font-size:.75rem; letter-spacing:.1em; text-transform:uppercase; font-weight:500;
    text-decoration:none; transition:all .3s;
  }
  .pill-dark { background:var(--ink); color:var(--cream); }
  .pill-dark:hover { background:var(--green); }
  .pill-outline { border:1.5px solid var(--ink); color:var(--ink); }
  .pill-outline:hover { background:var(--ink); color:var(--cream); }
  .about-right { padding-top:4px; }
  .about-img-box {
    width:100%; aspect-ratio:4/5;
    background:var(--green);
    border-radius:8px; position:relative; overflow:hidden;
    display:flex; align-items:flex-end; padding:32px;
  }
  .about-img-box img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
  .about-img-box::before {
    content:''; position:absolute; inset:0;
    background: radial-gradient(circle at 30% 20%, rgba(232,125,176,.25) 0%, transparent 60%);
  }
  .about-img-tag {
    position:relative; font-size:.68rem; letter-spacing:.1em;
    text-transform:uppercase; color:rgba(240,236,217,.6);
    border:1px solid rgba(240,236,217,.2); padding:8px 18px;
    border-radius:100px; backdrop-filter:blur(8px);
  }
  .about-blob-deco {
    position:absolute; top:32px; right:32px;
    width:80px; height:80px; background:var(--pink); opacity:.7;
    border-radius:60% 40% 55% 45% / 50% 60% 40% 55%;
  }
  .about-stats {
    display:grid; grid-template-columns:1fr 1fr; gap:24px; margin-top:36px;
  }
  .stat { padding:24px; border:1.5px solid rgba(26,26,26,.08); border-radius:8px; }
  .stat-n { font-family:var(--display); font-weight:800; font-size:2.8rem; line-height:1; margin-bottom:4px; color:var(--ink); }
  .stat-n span { color:var(--green); }
  .stat-l { font-size:.7rem; letter-spacing:.1em; text-transform:uppercase; color:#888; }

  /* ── WORK ── */
  #work { padding:100px 48px; background:var(--green); }
  .work-header { display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:56px; }
  .work-title { font-family:var(--display); font-weight:800;
    font-size:clamp(2rem, 4.5vw, 4rem); line-height:.95; letter-spacing:-.03em; }
  .work-link { font-size:.72rem; letter-spacing:.12em; text-transform:uppercase;
    color:var(--pink); text-decoration:none;
    border-bottom:1px solid rgba(232,125,176,.4); padding-bottom:2px; transition:border-color .3s; }
  .work-link:hover { border-color:var(--pink); }

  .cases { display:flex; flex-direction:column; gap:2px; }
  .case-row {
    display:grid; grid-template-columns:80px 1fr auto;
    align-items:center; gap:32px;
    padding:28px 32px;
    background:rgba(240,236,217,.04);
    border:1px solid rgba(240,236,217,.07);
    border-radius:4px;
    transition:background .4s, border-color .4s;
    cursor:none; position:relative; overflow:hidden;
    text-decoration:none; color:var(--cream);
  }
  .case-row::before {
    content:''; position:absolute; inset:0;
    background:var(--pink); opacity:0;
    transition:opacity .45s;
  }
  .case-row:hover { border-color:rgba(232,125,176,.3); }
  .case-row:hover::before { opacity:.08; }
  .case-row > * { position:relative; z-index:1; }

  .case-row-num { font-family:var(--display); font-weight:800;
    font-size:1.8rem; color:rgba(240,236,217,.12); line-height:1;
    transition:color .3s; }
  .case-row:hover .case-row-num { color:var(--pink); }
  .case-row-thumb { width:64px; height:64px; border-radius:6px;
    background-size:cover; background-position:center; background-repeat:no-repeat;
    background-color:rgba(240,236,217,.08);
    border:1px solid rgba(240,236,217,.1); }
  .case-row-body {}
  .case-row-tag { font-size:.62rem; letter-spacing:.16em; text-transform:uppercase;
    color:var(--pink); margin-bottom:6px; }
  .case-row-title { font-family:var(--display); font-weight:700;
    font-size:clamp(1.1rem, 2vw, 1.6rem); line-height:1.1; }
  .case-row-desc { font-size:.82rem; line-height:1.6; color:rgba(240,236,217,.5); margin-top:6px; }
  .case-row-meta { text-align:right; }
  .case-row-year { font-size:.72rem; letter-spacing:.1em; color:rgba(240,236,217,.35); display:block; margin-bottom:8px; }
  .case-row-arrow {
    width:40px; height:40px; border:1px solid rgba(240,236,217,.15);
    border-radius:50%; display:flex; align-items:center; justify-content:center;
    margin-left:auto; transition:background .3s, border-color .3s;
  }
  .case-row-arrow svg { width:14px; color:rgba(240,236,217,.5); transition:color .3s; }
  .case-row:hover .case-row-arrow { background:var(--pink); border-color:var(--pink); }
  .case-row:hover .case-row-arrow svg { color:#fff; }

  /* BIG CARD for featured */
  .case-featured {
    background:rgba(240,236,217,.06);
    border:1px solid rgba(240,236,217,.09);
    border-radius:4px; padding:0; overflow:hidden;
    margin-bottom:2px; text-decoration:none; color:var(--cream);
    display:block; cursor:none; position:relative;
  }
  .case-feat-inner {
    display:grid; grid-template-columns:1fr 1fr; min-height:360px;
  }
  .case-feat-content { padding:52px 48px; display:flex; flex-direction:column; justify-content:flex-end; }
  .case-feat-tag { font-size:.62rem; letter-spacing:.16em; text-transform:uppercase;
    color:var(--pink); margin-bottom:14px; }
  .case-feat-title { font-family:var(--display); font-weight:800;
    font-size:clamp(1.6rem, 3vw, 2.8rem); line-height:1.05; letter-spacing:-.02em; }
  .case-feat-desc { font-size:.88rem; line-height:1.7; color:rgba(240,236,217,.55);
    margin-top:14px; max-width:360px; }
  .case-feat-cta { display:inline-flex; align-items:center; gap:10px;
    margin-top:28px; font-size:.72rem; letter-spacing:.1em; text-transform:uppercase;
    color:var(--cream); transition:gap .3s; }
  .case-feat-cta .arr { width:32px; height:1px; background:var(--cream); position:relative; transition:width .4s; }
  .case-feat-cta .arr::after { content:''; position:absolute; right:0; top:-3px;
    width:7px; height:7px; border-right:1px solid var(--cream); border-top:1px solid var(--cream);
    transform:rotate(45deg); }
  .case-featured:hover .case-feat-cta .arr { width:52px; }
  .case-feat-visual {
    background:linear-gradient(135deg, rgba(232,125,176,.15) 0%, rgba(42,110,63,.5) 100%);
    background-size:cover; background-position:center; background-repeat:no-repeat;
    position:relative; display:flex; align-items:center; justify-content:center;
  }
  .feat-blob {
    width:60%; aspect-ratio:1; background:var(--pink); opacity:.25;
    border-radius:60% 40% 55% 45% / 50% 60% 40% 55%;
    animation:blobFloat 6s ease-in-out infinite;
  }
  .feat-num {
    position:absolute; bottom:32px; right:32px;
    font-family:var(--display); font-weight:800;
    font-size:5rem; color:rgba(240,236,217,.06); line-height:1;
  }

  /* ── CONTACT ── */
  #contact { padding:140px 48px 100px; background:var(--pink); color:var(--ink); text-align:center; position:relative; overflow:hidden; }
  .contact-bg-text {
    position:absolute; top:50%; left:50%; transform:translate(-50%,-50%);
    font-family:var(--display); font-weight:800;
    font-size:clamp(9rem, 20vw, 20rem);
    color:rgba(42,110,63,.1); white-space:nowrap; pointer-events:none; line-height:1;
  }
  .contact-inner { position:relative; z-index:2; }
  .contact-eyebrow { font-size:.68rem; letter-spacing:.18em; text-transform:uppercase;
    color:rgba(26,26,26,.5); margin-bottom:24px; }
  .contact-heading { font-family:var(--display); font-weight:800;
    font-size:clamp(3rem, 8vw, 8rem); line-height:.9; letter-spacing:-.04em;
    margin-bottom:48px; color:var(--ink); }
  .contact-heading .cream { color:var(--cream); }
  .contact-email {
    display:inline-flex; align-items:center; gap:12px;
    font-family:var(--display); font-weight:700;
    font-size:clamp(1.1rem, 2.5vw, 1.8rem);
    color:var(--ink); text-decoration:none;
    border-bottom:2px solid rgba(26,26,26,.25); padding-bottom:4px;
    transition:all .3s;
  }
  .contact-email:hover { border-color:var(--ink); }
  .contact-socials { display:flex; justify-content:center; gap:36px; margin-top:56px; }
  .c-soc { font-size:.7rem; letter-spacing:.14em; text-transform:uppercase;
    color:rgba(26,26,26,.6); text-decoration:none; transition:color .2s;
    position:relative; }
  .c-soc::after { content:''; position:absolute; bottom:-2px; left:0;
    width:0; height:1px; background:var(--ink); transition:width .3s; }
  .c-soc:hover { color:var(--ink); }
  .c-soc:hover::after { width:100%; }

  /* ── FOOTER ── */
  footer { padding:24px 48px; background:var(--ink); color:rgba(240,236,217,.4);
    display:flex; justify-content:space-between; align-items:center; }
  footer span { font-size:.68rem; letter-spacing:.1em; }
  .ft-dot { display:flex; align-items:center; gap:8px; }
  .green-dot { width:7px; height:7px; background:#4CAF50; border-radius:50%; animation:pulse 2s ease infinite; }

  /* ── SCROLL REVEAL ── */
  .rv { opacity:0; transform:translateY(40px);
    transition:opacity .9s cubic-bezier(.23,1,.32,1), transform .9s cubic-bezier(.23,1,.32,1); }
  .rv.in { opacity:1; transform:none; }
  .d1 { transition-delay:.1s; } .d2 { transition-delay:.22s; }
  .d3 { transition-delay:.36s; } .d4 { transition-delay:.52s; }

  @keyframes nameIn { from{opacity:0;transform:translateY(60px)} to{opacity:1;transform:none} }
  @keyframes fadeUp { from{opacity:0;transform:translateY(24px)} to{opacity:1;transform:none} }
  @keyframes blobFloat { 0%,100%{border-radius:60% 40% 55% 45%/50% 60% 40% 55%;transform:translate(0,0) rotate(0deg)} 33%{border-radius:50% 50% 40% 60%/55% 45% 60% 40%;transform:translate(8px,-12px) rotate(3deg)} 66%{border-radius:45% 55% 60% 40%/40% 55% 45% 60%;transform:translate(-6px,6px) rotate(-2deg)} }
  @keyframes blobIn { from{opacity:0;transform:scale(.7)} to{opacity:1;transform:scale(1)} }
  @keyframes marquee { from{transform:translateX(0)} to{transform:translateX(-50%)} }
  @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:.3} }

  /* Dispositivi touch: niente cursore finto, torna quello di sistema */
  @media (hover:none), (pointer:coarse) {
    #cur, #ring { display:none; }
    body { cursor:auto; }
    .case-row, .case-featured { cursor:pointer; }
  }

  @media(max-width:900px){
    nav{padding:18px 24px;}
    .nav-links{gap:20px;}
    #hero{padding:0 0 40px;}
    .hero-name-wrap{padding:70px 24px 0;}
    .hero-bottom{padding:0 24px;flex-direction:column;align-items:flex-start;gap:24px;}
    .hero-right-info{text-align:left;}
    /* La blob si sposta in alto a destra: sotto c'è il testo */
    .hero-blob{
      width:min(40vw,300px);
      top:17vh; right:6vw;
      bottom:auto; left:auto;
    }
    #about{padding:72px 24px;}
    .about-grid{grid-template-columns:1fr;}
    #work{padding:72px 24px;}
    .case-feat-inner{grid-template-columns:1fr;}
    .case-feat-visual{min-height:200px;}
    .case-row{grid-template-columns:60px 1fr auto;}
    #contact{padding:100px 24px 80px;}
    footer{padding:20px 24px;flex-direction:column;gap:10px;text-align:center;}
  }

  @media(max-width:640px){
    /* NAV: logo e voci devono convivere senza toccarsi */
    nav{padding:14px 16px; gap:10px;}
    nav.stuck{padding:11px 16px;}
    .nav-logo{font-size:.76rem;}
    .nav-links{gap:11px;}
    .nav-links a{font-size:.58rem; letter-spacing:.06em; padding:9px 0; display:block;}

    /* NOME: si adatta alla larghezza, non viene tagliato */
    .hero-name{font-size:clamp(2.6rem,21vw,7rem);}
    .hero-name .line2{padding-left:6vw;}
    .hero-name-wrap{padding:56px 20px 0;}
    .hero-bottom{padding:0 20px;}
    .hero-blob{width:46vw; top:14vh; right:5vw;}

    /* PROGETTI: il testo aveva solo 100px, ora va a tutta larghezza */
    #work{padding:64px 20px;}
    .case-row{
      grid-template-columns:44px 1fr;
      gap:12px 14px;
      padding:22px 18px;
      align-items:start;
    }
    .case-row-num, .case-row-thumb{grid-row:1; grid-column:1;}
    .case-row-thumb{width:44px; height:44px;}
    .case-row-num{font-size:1.4rem; padding-top:2px;}
    .case-row-body{grid-row:1; grid-column:2;}
    .case-row-meta{
      grid-row:2; grid-column:2;
      display:flex; align-items:center; justify-content:space-between;
      text-align:left;
    }
    .case-row-year{margin-bottom:0;}
    .case-row-arrow{margin-left:0; width:36px; height:36px;}
    .case-feat-content{padding:36px 24px;}

    /* Aree toccabili più grandi */
    .contact-socials{gap:22px; flex-wrap:wrap;}
    .c-soc{padding:10px 0;}

    #about{padding:64px 20px;}
    #contact{padding:88px 20px 72px;}
  }

  /* Schermi bassi: la blob deve restare sopra al nome, non dietro */
  @media(max-width:640px) and (max-height:700px){
    .hero-blob{width:min(28vw,100px); top:52px; right:5vw;}
  }

  /* Schermi molto stretti: nome intero + 4 voci non ci stanno */
  @media(max-width:340px){
    .nav-links{display:none;}
  }
</style>
</head>
<body>

<div id="cur"></div>
<div id="ring"></div>

<!-- NAV -->
<nav id="nav">
  <a href="#" class="nav-logo">{{ site.logo }}</a>
  <ul class="nav-links">
    <li><a href="#about">{{ site.nav_about }}</a></li>
    <li><a href="#work">{{ site.nav_work }}</a></li>
    <li><a href="#contact">{{ site.nav_contact }}</a></li>
  </ul>
</nav>

<!-- HERO -->
<section id="hero">
  <div class="hero-blob" aria-hidden="true"></div>
  <div class="hero-name-wrap">
    <h1 class="hero-name">
      {{ hero.name_line1 }}<span class="line2">{{ hero.name_line2 }}</span>
    </h1>
  </div>
  <div class="hero-bottom">
    <div class="hero-left-info">
      <div class="hero-year">{{ hero.year }}</div>
      <div class="hero-role">{{ hero.role }}</div>
    </div>
    <div class="hero-right-info">
      <p class="hero-tagline-bold">{{ hero.tagline_bold }}</p>
      <p class="hero-tagline">{{ hero.tagline }}</p>
      <a href="#work" class="hero-cta">{{ hero.cta_text }} →</a>
    </div>
  </div>
</section>

<!-- MARQUEE -->
<div class="marquee-strip" aria-hidden="true">
  <div class="marquee-inner">
    {% for item in marquee.items %}
    <span class="m-item">{{ item }}</span><span class="m-item m-dot">✦</span>
    {% endfor %}
    {% for item in marquee.items %}
    <span class="m-item">{{ item }}</span><span class="m-item m-dot">✦</span>
    {% endfor %}
  </div>
</div>

<!-- ABOUT -->
<section id="about">
  <div class="about-grid">
    <div class="about-left">
      <p class="sec-label" data-n="01">{{ about.label }}</p>
      <h2 class="about-heading rv">{{ about.heading_line1 }}<br>{{ about.heading_line2 }} <span class="pink">{{ about.heading_highlight }}</span><br>{{ about.heading_line3 }}</h2>
      {% for p in about.paragraphs %}
      <p class="about-text rv d1">{{ p }}</p>
      {% endfor %}
      <div class="about-cta-row rv d2">
        <a href="#work" class="pill pill-dark">{{ about.cta_primary_text }}</a>
        <a href="mailto:{{ contact.email }}" class="pill pill-outline">{{ about.cta_secondary_text }}</a>
      </div>
    </div>
    <div class="about-right rv d2">
      <div class="about-img-box">
        {% if about.photo %}
        <img src="{{ about.photo }}" alt="{{ hero.name_line1 }} {{ hero.name_line2 }}">
        {% endif %}
        <div class="about-blob-deco" aria-hidden="true"></div>
        {% if not about.photo %}
        <span class="about-img-tag">{{ about.image_tag }}</span>
        {% endif %}
      </div>
      <div class="about-stats rv d3">
        {% for s in about.stats %}
        <div class="stat"><div class="stat-n"{% if s.number|length > 3 %} style="font-size:1.8rem"{% endif %}>{{ s.number }}<span>{{ s.suffix }}</span></div><div class="stat-l">{{ s.label }}</div></div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<!-- WORK -->
<section id="work">
  <div class="work-header rv">
    <div>
      <p class="sec-label" data-n="02" style="color:rgba(240,236,217,.4)">{{ work.label }}</p>
      <h2 class="work-title">{{ work.title_line1 }}<br>{{ work.title_line2 }}</h2>
    </div>
    {% if work.all_link_url and work.all_link_url != "#" %}<a href="{{ work.all_link_url }}" class="work-link">{{ work.all_link_text }}</a>{% endif %}
  </div>

  <!-- FEATURED -->
  {% set featUrl = work.featured.url if work.featured.url and work.featured.url != "#" else "" %}
  <{% if featUrl %}a href="{{ featUrl }}"{% else %}div{% endif %} class="case-featured rv d1">
    <div class="case-feat-inner">
      <div class="case-feat-content">
        <p class="case-feat-tag">{{ work.featured.tag }}</p>
        <h3 class="case-feat-title">{{ work.featured.title }}</h3>
        <p class="case-feat-desc">{{ work.featured.desc }}</p>
        {% if featUrl %}<span class="case-feat-cta">{{ work.featured.cta_text }} <span class="arr"></span></span>{% endif %}
      </div>
      <div class="case-feat-visual"{% if work.featured.image %} style="background-image:url('{{ work.featured.image }}');"{% endif %} aria-hidden="true">
        {% if not work.featured.image %}<div class="feat-blob"></div>{% endif %}
        <div class="feat-num">01</div>
      </div>
    </div>
  </{% if featUrl %}a{% else %}div{% endif %}>

  <!-- LIST -->
  <div class="cases rv d2">
    {% for item in work.items %}
    {% set n = loop.index + 1 %}
    {% set itemUrl = item.url if item.url and item.url != "#" else "" %}
    <{% if itemUrl %}a href="{{ itemUrl }}"{% else %}div{% endif %} class="case-row">
      {% if item.image %}
      <div class="case-row-thumb" style="background-image:url('{{ item.image }}');"></div>
      {% else %}
      <div class="case-row-num">{% if n < 10 %}0{% endif %}{{ n }}</div>
      {% endif %}
      <div class="case-row-body">
        <p class="case-row-tag">{{ item.tag }}</p>
        <h3 class="case-row-title">{{ item.title }}</h3>
        <p class="case-row-desc">{{ item.desc }}</p>
      </div>
      <div class="case-row-meta">
        <span class="case-row-year">{{ item.year }}</span>
        {% if itemUrl %}<div class="case-row-arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M7 17L17 7M17 7H7M17 7v10"/></svg></div>{% endif %}
      </div>
    </{% if itemUrl %}a{% else %}div{% endif %}>
    {% endfor %}
  </div>
</section>

<!-- CONTACT -->
<section id="contact">
  <div class="contact-bg-text" aria-hidden="true">{{ contact.bg_word }}</div>
  <div class="contact-inner">
    <p class="contact-eyebrow rv">{{ contact.eyebrow }}</p>
    <h2 class="contact-heading rv d1">{{ contact.heading_line1 }}<br><span class="cream">{{ contact.heading_line2 }}</span></h2>
    <a href="mailto:{{ contact.email }}" class="contact-email rv d2">{{ contact.email }}</a>
    <div class="contact-socials rv d3">
      {% for soc in contact.socials %}{% if soc.url and soc.url != "#" %}
      <a href="{{ soc.url }}" class="c-soc" target="_blank" rel="noopener">{{ soc.name }}</a>
      {% endif %}{% endfor %}
    </div>
  </div>
</section>

<footer>
  <span>{{ footer.copyright }}</span>
  <div class="ft-dot">
    <span>{{ footer.status_text }}</span>
    <div class="green-dot"></div>
  </div>
</footer>

<script>
// CURSOR
const cur = document.getElementById('cur');
const ring = document.getElementById('ring');
let mx=0,my=0,rx=0,ry=0;
document.addEventListener('mousemove',e=>{
  mx=e.clientX; my=e.clientY;
  cur.style.left=mx+'px'; cur.style.top=my+'px';
});
(function animR(){
  rx+=(mx-rx)*.11; ry+=(my-ry)*.11;
  ring.style.left=rx+'px'; ring.style.top=ry+'px';
  requestAnimationFrame(animR);
})();
document.querySelectorAll('a,button,.case-row,.case-featured').forEach(el=>{
  el.addEventListener('mouseenter',()=>{ cur.classList.add('big'); ring.style.opacity='.12'; });
  el.addEventListener('mouseleave',()=>{ cur.classList.remove('big'); ring.style.opacity='.4'; });
});

// SCROLL REVEAL
const io=new IntersectionObserver(entries=>{
  entries.forEach(e=>{ if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); } });
},{threshold:.08});
document.querySelectorAll('.rv').forEach(el=>io.observe(el));

// NAV
const nav=document.getElementById('nav');
window.addEventListener('scroll',()=>{
  nav.classList.toggle('stuck', window.scrollY>50);
});
</script>
<script>
  if (/(confirmation_token|invite_token|recovery_token|email_change_token)=/.test(window.location.hash)) {
    window.location.href = "/admin/" + window.location.hash;
  }
</script>
</body>
</html>
